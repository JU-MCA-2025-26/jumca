{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "types": ["node"],

    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "allowJs": false,

    /* Override baseUrl to resolve from repo root (same as tsconfig.base) */
    "baseUrl": "../..",
    "paths": {
      "@shared/*": ["./packages/shared/src/*"],
      "@server/*": ["./apps/server/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
