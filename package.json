{
  "name": "jumca-portal",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev":    "npm run dev   --workspaces --if-present",
    "build":  "npm run build --workspaces --if-present",
    "lint":   "npm run lint  --workspaces --if-present",
    "client": "npm --workspace=apps/client run dev",
    "server": "npm --workspace=apps/server run dev"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "prisma": true,
    "bcrypt": true
  }
}
